# Use Apache NuttX’s Docker image as the base image. Refer to its Dockerfile here: https://github.com/apache/nuttx/blob/master/tools/ci/docker/linux/Dockerfile
FROM ghcr.io/apache/nuttx/apache-nuttx-ci-linux

# Install tools specific for openvela.
RUN apt-get update
RUN DEBIAN_FRONTEND="noninteractive" apt-get install -y -qq \
    build-essential \
    cmake \
    git \
    libgl1-mesa-glx \
    libncurses5-dev \
    libncursesw5-dev \
    libssl-dev \
    python3 \
    python3-pip \
    curl \
    jq \
    git-lfs \
    dosfstools \
    mtools \
    libc++abi1 \
    srecord

# libunwind-dev: arch/sim links -lunwind unconditionally, while the base image
# carries only the libunwind8 runtime. i386 as well, for CONFIG_SIM_M32 configs.
# python3-venv: the base image's Python has no ensurepip.
RUN dpkg --print-foreign-architectures | grep -q i386 || dpkg --add-architecture i386
RUN apt-get update
RUN DEBIAN_FRONTEND="noninteractive" apt-get install -y -qq \
    libunwind-dev \
    libunwind-dev:i386 \
    python3-venv
RUN git lfs install
RUN git lfs --version
RUN pip3 install matplotlib==3.6.2
RUN pip3 install html-table
RUN rm -rf /var/lib/apt/lists/*

# Set the command to be executed when the container starts.
CMD ["/bin/bash"]
