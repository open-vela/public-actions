FROM python:3.10-slim

LABEL maintainer="OpenVela Team"
LABEL description="Watermark detection tool for CI/CD pipelines"

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libgthread-2.0-0 \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    opencv-python-headless==4.8.1.78 \
    numpy==1.24.3 \
    paddlepaddle==2.6.2 \
    paddleocr==2.7.3

# Pre-download PaddleOCR models to avoid first-run download
# This significantly speeds up the first detection
RUN mkdir -p /root/.paddleocr/whl/det/en/en_PP-OCRv3_det_infer && \
    mkdir -p /root/.paddleocr/whl/rec/en/en_PP-OCRv4_rec_infer && \
    mkdir -p /root/.paddleocr/whl/cls/ch_ppocr_mobile_v2.0_cls_infer && \
    # Download and extract detection model
    cd /root/.paddleocr/whl/det/en/en_PP-OCRv3_det_infer && \
    wget -q https://paddleocr.bj.bcebos.com/PP-OCRv3/english/en_PP-OCRv3_det_infer.tar && \
    tar -xf en_PP-OCRv3_det_infer.tar --strip-components=1 && \
    rm en_PP-OCRv3_det_infer.tar && \
    # Download and extract recognition model (v4)
    cd /root/.paddleocr/whl/rec/en/en_PP-OCRv4_rec_infer && \
    wget -q https://paddleocr.bj.bcebos.com/PP-OCRv4/english/en_PP-OCRv4_rec_infer.tar && \
    tar -xf en_PP-OCRv4_rec_infer.tar --strip-components=1 && \
    rm en_PP-OCRv4_rec_infer.tar && \
    # Download and extract angle classification model
    cd /root/.paddleocr/whl/cls/ch_ppocr_mobile_v2.0_cls_infer && \
    wget -q https://paddleocr.bj.bcebos.com/dygraph_v2.0/ch/ch_ppocr_mobile_v2.0_cls_infer.tar && \
    tar -xf ch_ppocr_mobile_v2.0_cls_infer.tar --strip-components=1 && \
    rm ch_ppocr_mobile_v2.0_cls_infer.tar

# Copy the watermark detection script
COPY detect_watermark.py /usr/local/bin/detect_watermark.py
RUN chmod +x /usr/local/bin/detect_watermark.py

# Copy Chinese character detection scripts
COPY check_commit_msg.py /usr/local/bin/check_commit_msg.py
COPY check_source_files.py /usr/local/bin/check_source_files.py
RUN chmod +x /usr/local/bin/check_commit_msg.py && \
    chmod +x /usr/local/bin/check_source_files.py

# Install git for Chinese detection scripts
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Set entrypoint
ENTRYPOINT ["python3", "/usr/local/bin/detect_watermark.py"]
